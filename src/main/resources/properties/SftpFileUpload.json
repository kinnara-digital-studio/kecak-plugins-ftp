[
  {
    "title": "@@ftp.sftpFileUpload@@",
    "properties": [
      {
        "name" : "id",
        "label" : "@@ftp.id@@",
        "type" : "textfield",
        "required" : "True",
        "regex_validation" : "^[a-zA-Z0-9_]+$",
        "validation_message" : "@@form.fileupload.invalidId@@"
      },
      {
        "name" : "label",
        "label" : "@@ftp.label@@",
        "type" : "textfield",
        "required" : "True",
        "value" : "FTP File Upload"
      }
    ]
  },
  {
    "title": "Connection",
    "properties": [
      {
        "name": "host",
        "label": "Host",
        "type": "textfield"
      },
      {
        "name": "port",
        "label": "@@ftp.port@@",
        "type": "textfield",
        "value": "22",
        "regex_validation": "\\d+"
      },
      {
        "name": "username",
        "label": "Username",
        "type": "textfield"
      },
      {
        "name": "logonType",
        "label": "Logon Type",
        "type": "radio",
        "options": [
          {
            "value": "password",
            "label": "Password"
          },
          {
            "value": "keyFile",
            "label": "Key File"
          }
        ],
        "value": "password"
      },
      {
        "name": "password",
        "label": "Password",
        "type": "password",
        "control_field": "logonType",
        "control_value": "password"
      },
      {
        "name": "keyFile",
        "label": "Key File Path",
        "type": "textfield",
        "control_field": "logonType",
        "control_value": "keyFile"
      },
      {
        "name": "remoteFolder",
        "label": "Remote Folder",
        "type": "textfield"
      },
      {
        "name": "knownHostsFile",
        "label": "Known Hosts File",
        "type": "textfield",
        "value": "/root/.ssh/known_hosts"
      }
    ]
  }
]
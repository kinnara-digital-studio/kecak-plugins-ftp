[
  {
    "title": "@@ftp.ftpFileUpload@@",
    "properties": [
      {
        "name" : "id",
        "label" : "@@ftp.id@@",
        "type" : "textfield",
        "required" : "True",
        "regex_validation" : "^[a-zA-Z0-9_]+$",
        "validation_message" : "@@form.fileupload.invalidId@@"
      },
      {
        "name" : "label",
        "label" : "@@ftp.label@@",
        "type" : "textfield",
        "required" : "True",
        "value" : "FTP File Upload"
      }
    ]
  },
  {
    "title": "Connection",
    "properties": [
      {
        "name": "ftpHost",
        "label": "Host",
        "type": "textfield",
        "required": "true"
      },
      {
        "name": "ftpPort",
        "label": "Port",
        "type": "textfield",
        "value": "21",
        "required": "true",
        "regex_validation": "\\d+"
      },
      {
        "name": "username",
        "label": "Username",
        "type": "textfield",
        "required": "true"
      },
      {
        "name": "password",
        "label": "Password",
        "type": "password"
      },
      {
        "name": "remoteFolder",
        "label": "Remote Folder",
        "type": "textfield"
      }
    ]
  }
]